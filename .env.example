# Do not commit your actual .env file to Git! It may contain secrets.
# Copy this file to `.env` and run the action locally with `npm run local-action`.

# Enable/disable step debug logging (default: `false`).
ACTIONS_STEP_DEBUG=true

# Action inputs follow the `INPUT_<NAME>` format (case-sensitive).
# Hyphens in input names are NOT converted to underscores.
INPUT_NAME=Pitest report
INPUT_FILE=mutations.xml
INPUT_SUMMARY=false
INPUT_ANNOTATION-TYPES=SURVIVED
# Use `workflow` for local runs; `checks` calls the GitHub API and needs a real token/repo.
INPUT_OUTPUT=workflow
INPUT_MAX-ANNOTATIONS=10
INPUT_THRESHOLD=0
INPUT_TOKEN=dummy-token

# GitHub Actions default environment variables. Only needed for `INPUT_OUTPUT=checks`.
# GITHUB_REPOSITORY="owner/repo"
# GITHUB_SHA=""
# GITHUB_STEP_SUMMARY=""
